@model IEnumerable<FleetCarePro.Models.Vehicle>

@{
    ViewData["Title"] = "Vehicles";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Vehicles List</h2>
    <a asp-action="Create" class="btn btn-primary">Add New Vehicle</a>
</div>

<div class="row">
    @if (!Model.Any())
    {
        <div class="col-12">
            <div class="alert alert-info">No vehicles found. Click above to add one!</div>
        </div>
    }
    else
    {
        @foreach (var vehicle in Model)
        {
            <div class="col-md-4 mb-3">
                <partial name="_VehicleCard" model="vehicle" />
            </div>
        }
    }
</div>