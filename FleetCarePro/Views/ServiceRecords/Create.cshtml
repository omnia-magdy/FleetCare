@model FleetCarePro.ViewModels.ServiceRecordCreateViewModel

@{
    ViewData["Title"] = "Create Service Record";
}

<div class="container mt-4">
    <h2>Create Vehicle Service Record</h2>
    <hr />

    <form asp-action="Create" enctype="multipart/form-data" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="card mb-4">
            <div class="card-header bg-primary text-white">Basic Information</div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="VehicleId" class="form-label">Vehicle</label>
                        <select asp-for="VehicleId" asp-items="ViewBag.Vehicles" class="form-select">
                            <option value="">-- Select Vehicle --</option>
                        </select>
                        <span asp-validation-for="VehicleId" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="ServiceCenterId" class="form-label">Service Center</label>
                        <select asp-for="ServiceCenterId" asp-items="ViewBag.ServiceCenters" class="form-select">
                            <option value="">-- Select Service Center --</option>
                        </select>
                        <span asp-validation-for="ServiceCenterId" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="ServiceDate" class="form-label">Service Date</label>
                        <input asp-for="ServiceDate" class="form-control" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="CurrentMileage" class="form-label">Current Mileage</label>
                        <input asp-for="CurrentMileage" class="form-control" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="InvoiceDocument" class="form-label">Invoice Attachment</label>
                        <input asp-for="InvoiceDocument" type="file" class="form-control" accept=".pdf,.jpg,.jpeg,.png" />
                        <small class="text-muted">Max size: 5MB (.pdf, .jpg, .png)</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center">
                <span>Line Items</span>
                <button type="button" id="btn-add-item" class="btn btn-sm btn-light">+ Add Item</button>
            </div>
            <div class="card-body p-0">
                <table class="table table-bordered mb-0">
                    <thead>
                        <tr>
                            <th style="width: 30%;">Category</th>
                            <th style="width: 45%;">Description</th>
                            <th style="width: 15%;">Cost</th>
                            <th style="width: 10%;">Action</th>
                        </tr>
                    </thead>
                    <tbody id="line-items-body">
                        @for (int i = 0; i < Model.LineItems.Count; i++)
                        {
                            <tr>
                                <td>
                                    <select name="LineItems[@i].ServiceCategoryId" class="form-select" asp-items="ViewBag.ServiceCategories">
                                        <option value="">-- Select Category --</option>
                                    </select>
                                </td>
                                <td>
                                    <input name="LineItems[@i].Description" value="@Model.LineItems[i].Description" class="form-control" />
                                </td>
                                <td>
                                    <input name="LineItems[@i].Cost" value="@Model.LineItems[i].Cost" type="number" step="0.01" class="form-control" />
                                </td>
                                <td>
                                    <button type="button" class="btn btn-danger btn-sm remove-item-btn">Delete</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <button type="submit" class="btn btn-success btn-lg">Save Service Record</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const tableBody = document.getElementById("line-items-body");
            const addButton = document.getElementById("btn-add-item");

            const categoryOptions = `@Html.Raw(string.Join("", ((SelectList)ViewBag.ServiceCategories).Select(c => $"<option value='{c.Value}'>{c.Text}</option>")))`;

            addButton.addEventListener("click", function () {
                const index = tableBody.children.length;
                const newRow = document.createElement("tr");

                newRow.innerHTML = `
                    <td>
                        <select name="LineItems[${index}].ServiceCategoryId" class="form-select">
                            <option value="">-- Select Category --</option>
                            ${categoryOptions}
                        </select>
                    </td>
                    <td>
                        <input name="LineItems[${index}].Description" class="form-control" />
                    </td>
                    <td>
                        <input name="LineItems[${index}].Cost" type="number" step="0.01" class="form-control" value="0.00" />
                    </td>
                    <td>
                        <button type="button" class="btn btn-danger btn-sm remove-item-btn">Delete</button>
                    </td>
                `;

                tableBody.appendChild(newRow);
            });

            tableBody.addEventListener("click", function (e) {
                if (e.target && e.target.classList.contains("remove-item-btn")) {
                    if (tableBody.children.length > 1) {
                        e.target.closest("tr").remove();
                        reIndexRows();
                    } else {
                        alert("At least one line item is required.");
                    }
                }
            });

            function reIndexRows() {
                Array.from(tableBody.children).forEach((row, idx) => {
                    row.querySelector("select").name = `LineItems[${idx}].ServiceCategoryId`;
                    const inputs = row.querySelectorAll("input");
                    inputs[0].name = `LineItems[${idx}].Description`;
                    inputs[1].name = `LineItems[${idx}].Cost`;
                });
            }
        });
    </script>
}