@model IEnumerable<FleetCarePro.Models.ServiceRecord>

@{
    ViewData["Title"] = "Service Records";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Service History</h2>
        <a asp-action="Create" class="btn btn-primary">+ Log New Service</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Vehicle</th>
                        <th>Service Date</th>
                        <th>Total Cost</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">No service records found.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@(item.Vehicle != null ? $"{item.Vehicle.Make} {item.Vehicle.Model} ({item.Vehicle.LicensePlate})" : "N/A")</td>
                                <td>@item.ServiceDate.ToString("yyyy-MM-dd")</td>
                                <td>$@item.TotalCost.ToString("N2")</td>
                                <td><span class="badge bg-success">Completed</span></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>