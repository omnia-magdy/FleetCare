@using FleetCarePro.Models
@model FleetCarePro.Models.Vehicle

<div class="card h-100 shadow-sm border-0">
    @if (!string.IsNullOrEmpty(Model.VehicleImageURL))
    {
        <img src="@Model.VehicleImageURL" class="card-img-top" alt="@Model.Make @Model.Model" style="height: 180px; object-fit: cover;">
    }
    else
    {
        <div class="bg-light text-center py-4 text-muted" style="height: 180px;">
            <i class="bi bi-truck display-4"></i>
            <p class="mb-0 mt-1">No Image Available</p>
        </div>
    }

    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h5 class="card-title mb-0">@Model.Make @Model.Model</h5>
            <span class="badge bg-primary">@Model.Year</span>
        </div>

        <ul class="list-group list-group-flush small mb-3">
            <li class="list-group-item d-flex justify-content-between px-0">
                <span class="text-muted">License Plate:</span>
                <strong>@Model.LicensePlate</strong>
            </li>
            <li class="list-group-item d-flex justify-content-between px-0">
                <span class="text-muted">Current Mileage:</span>
                <strong>@Model.Mileage.ToString("N0") km</strong>
            </li>
            <li class="list-group-item d-flex justify-content-between px-0">
                <span class="text-muted">Status:</span>
                @if (Model.Status == VehicleStatus.Active)
                {
                    <span class="badge bg-success">Active</span>
                }
                else if (Model.Status == VehicleStatus.InService)
                {
                    <span class="badge bg-warning text-dark">In Service</span>
                }
                else
                {
                    <span class="badge bg-danger">Decommissioned</span>
                }
            </li>
        </ul>

        <div class="d-grid gap-2">
            <a asp-controller="Vehicles" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm">
                View Details
            </a>
        </div>
    </div>
</div>