@model FleetCarePro.ViewComponents.FleetCostSummaryViewModel

<div class="card border-primary mb-4 shadow-sm">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h6 class="card-title text-muted mb-0">Monthly Maintenance Cost</h6>
            <span class="badge bg-primary">@Model.MonthName</span>
        </div>
        <h2 class="display-6 fw-bold text-primary mb-1">
            $@Model.TotalCost.ToString("N2")
        </h2>
        <p class="card-text text-muted small">
            Total of <strong>@Model.InvoicesCount</strong> invoices processed this month.
        </p>
    </div>
</div>